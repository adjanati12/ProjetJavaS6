<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.SaisieResultatController"
            style="-fx-background-color: #F0F2F8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-padding: 14 24;
                     -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <Label text="Saisie des résultats"
                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelWarning" visible="false"
                   style="-fx-background-color: #FEF3C7; -fx-text-fill: #B45309;
                          -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 20; -fx-font-size: 12;"/>
            <Button text="Sauvegarder" onAction="#sauvegarder"
                    style="-fx-background-color: #1C6B43; -fx-text-fill: white; -fx-font-size: 12;
                           -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 8 16; -fx-cursor: hand;"/>
            <Button text="Fermer" onAction="#fermer"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 12;
                           -fx-background-radius: 7; -fx-padding: 8 14; -fx-border-color: #E2E8F0;
                           -fx-border-radius: 7; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="0" style="-fx-background-color: white; -fx-min-width: 230; -fx-max-width: 230;
                                  -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">
            <VBox style="-fx-padding: 20 18 16 18;" spacing="14">
                <Label text="FILTRES" style="-fx-font-size: 10; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                <VBox spacing="5">
                    <Label text="UE" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <ComboBox fx:id="filtreUE" maxWidth="Infinity" onAction="#rafraichirTableau"
                              style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1; -fx-border-radius: 7;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Parcours" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <ComboBox fx:id="filtreParcours" maxWidth="Infinity" onAction="#rafraichirTableau"
                              style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1; -fx-border-radius: 7;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Résultat" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <ComboBox fx:id="filtreResultat" maxWidth="Infinity" onAction="#rafraichirTableau"
                              style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1; -fx-border-radius: 7;"/>
                </VBox>
                <Separator/>
                <Label text="ACTIONS GLOBALES" style="-fx-font-size: 10; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                <Button text="✓  Tout valider" onAction="#toutValider" maxWidth="Infinity"
                        style="-fx-background-color: #DCFCE7; -fx-text-fill: #166534; -fx-font-size: 12;
                               -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 0; -fx-cursor: hand;"/>
                <Button text="✗  Tout échouer" onAction="#toutEchouer" maxWidth="Infinity"
                        style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-font-size: 12;
                               -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 0; -fx-cursor: hand;"/>
                <Separator/>
                <Label text="INSCRIPTION" style="-fx-font-size: 10; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                <Button text="Inscrire en masse à une UE" onAction="#ouvrirInscriptionMasse" maxWidth="Infinity"
                        style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-size: 12;
                               -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 0; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-padding: 20 24;" spacing="0">
            <TableView fx:id="tableau" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                <columns>
                    <TableColumn fx:id="colEtudiant" text="Étudiant" prefWidth="190"/>
                    <TableColumn fx:id="colParcours" text="Parcours" prefWidth="100"/>
                    <TableColumn fx:id="colUE" text="UE" prefWidth="210"/>
                    <TableColumn fx:id="colEcts" text="ECTS" prefWidth="70"/>
                    <TableColumn fx:id="colResultat" text="Résultat" prefWidth="175"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>