<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.SaisieResultatController"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;" spacing="15">

    <!-- PANNEAU GAUCHE : FILTRES -->
    <VBox spacing="15" prefWidth="220"
          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;
                 -fx-border-color: #e0e0e0; -fx-border-radius: 8;">

        <Label text="Filtres" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
        <Separator/>

        <VBox spacing="5">
            <Label text="UE" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="filtreUE" maxWidth="Infinity" onAction="#rafraichirTableau"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Parcours" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="filtreParcours" maxWidth="Infinity" onAction="#rafraichirTableau"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Resultat" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="filtreResultat" maxWidth="Infinity" onAction="#rafraichirTableau"/>
        </VBox>

        <Separator/>

        <Label text="Actions globales" style="-fx-font-weight: bold;"/>
        <Button text="Tout valider" onAction="#toutValider" maxWidth="Infinity"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 0;"/>
        <Button text="Tout echouer" onAction="#toutEchouer" maxWidth="Infinity"
                style="-fx-background-color: #f44336; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 0;"/>
        <Separator/>
        <Label text="Inscription en masse" style="-fx-font-weight: bold;"/>
        <Button text="Inscrire a une UE" onAction="#ouvrirInscriptionMasse" maxWidth="Infinity"
                style="-fx-background-color: #1565c0; -fx-text-fill: white;
               -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 0;"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button text="Sauvegarder" onAction="#sauvegarder" maxWidth="Infinity"
                style="-fx-background-color: #1a237e; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 0;"/>
        <Button text="Fermer" onAction="#fermer" maxWidth="Infinity"
                style="-fx-background-color: #757575; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 0;"/>
    </VBox>

    <!-- PANNEAU DROIT : TABLEAU -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Saisie des resultats"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>

        <Label fx:id="labelWarning" visible="false" maxWidth="Infinity"
               style="-fx-background-color: #fff3e0; -fx-text-fill: #e65100;
                      -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 5;"/>

        <TableView fx:id="tableau" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEtudiant" text="Etudiant" prefWidth="180"/>
                <TableColumn fx:id="colParcours" text="Parcours" prefWidth="100"/>
                <TableColumn fx:id="colUE" text="UE en cours" prefWidth="200"/>
                <TableColumn fx:id="colEcts" text="ECTS" prefWidth="70"/>
                <TableColumn fx:id="colResultat" text="Resultat" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>

</HBox>
