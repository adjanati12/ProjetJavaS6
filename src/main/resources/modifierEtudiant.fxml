<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ModifierEtudiantController"
      style="-fx-padding: 20; -fx-background-color: white;">
    <Label text="Modifier un étudiant" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    <Separator/>
    <GridPane hgap="10" vgap="10">
        <Label text="Numéro :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="labelNumero" style="-fx-text-fill: gray;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Nom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="champNom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Prénom :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="champPrenom" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="messageErreur" style="-fx-text-fill: red;"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#annuler"/>
        <Button text="Enregistrer" onAction="#enregistrer"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>
</VBox>
