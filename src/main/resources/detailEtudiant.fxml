<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.DetailEtudiantController"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;" spacing="10">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button text="Retour a la liste" onAction="#fermer"
                style="-fx-background-color: transparent; -fx-text-fill: #1a237e;
                       -fx-font-weight: bold; -fx-font-size: 12;"/>
        <Label fx:id="labelNom"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Modifier" onAction="#ouvrirModification"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 6 14;"/>
    </HBox>

    <!-- INFOS ETUDIANT -->
    <HBox spacing="30" style="-fx-background-color: white; -fx-padding: 12;
                               -fx-background-radius: 8; -fx-border-color: #e0e0e0;
                               -fx-border-radius: 8;">
        <VBox spacing="3">
            <Label text="N Etudiant" style="-fx-text-fill: gray; -fx-font-size: 11;"/>
            <Label fx:id="labelNumero" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        </VBox>
        <VBox spacing="3">
            <Label text="Mention" style="-fx-text-fill: gray; -fx-font-size: 11;"/>
            <Label fx:id="labelMention" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        </VBox>
        <VBox spacing="3">
            <Label text="Parcours" style="-fx-text-fill: gray; -fx-font-size: 11;"/>
            <Label fx:id="labelParcours" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        </VBox>
        <VBox spacing="3">
            <Label text="Semestre actuel" style="-fx-text-fill: gray; -fx-font-size: 11;"/>
            <Label fx:id="labelSemestre" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="3" alignment="CENTER_RIGHT">
            <Label text="ECTS valides" style="-fx-text-fill: gray; -fx-font-size: 11;"/>
            <Label fx:id="labelEcts"
                   style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1a237e;"/>
            <ProgressBar fx:id="progressDiplome" prefWidth="150" prefHeight="8"/>
            <Label fx:id="labelPourcentage"
                   style="-fx-font-size: 11; -fx-text-fill: gray;"/>
        </VBox>
    </HBox>

    <!-- ONGLETS -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             style="-fx-background-color: white; -fx-background-radius: 8;">

        <!-- ONGLET UE EN COURS -->
        <Tab text="UE en cours" closable="false">
            <VBox spacing="10" style="-fx-padding: 15;">
                <Label fx:id="labelEctsSemestre"
                       style="-fx-background-color: #e3f2fd; -fx-padding: 6 12;
                              -fx-background-radius: 5; -fx-font-size: 12;
                              -fx-text-fill: #1565c0; -fx-font-weight: bold;"/>
                <ListView fx:id="listeUeEnCours" VBox.vgrow="ALWAYS" prefHeight="200"/>
                <Button text="+ Inscrire a une UE" onAction="#ajouterInscription"
                        style="-fx-background-color: #1a237e; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 16;"/>
            </VBox>
        </Tab>

        <!-- ONGLET UE VALIDEES -->
        <Tab text="UE validees" closable="false">
            <VBox spacing="10" style="-fx-padding: 15;">
                <ListView fx:id="listeUeValidees" VBox.vgrow="ALWAYS" prefHeight="250"/>
            </VBox>
        </Tab>

        <!-- ONGLET UE DISPONIBLES -->
        <Tab text="UE disponibles" closable="false">
            <VBox spacing="10" style="-fx-padding: 15;">
                <Label text="UE dont les prerequis sont valides et non encore suivies :"
                       style="-fx-text-fill: gray; -fx-font-size: 11;"/>
                <ListView fx:id="listeUEDisponibles" VBox.vgrow="ALWAYS" prefHeight="250"/>
            </VBox>
        </Tab>

        <!-- ONGLET HISTORIQUE -->
        <Tab text="Historique" closable="false">
            <VBox spacing="10" style="-fx-padding: 15;">
                <ListView fx:id="listeHistorique" VBox.vgrow="ALWAYS" prefHeight="250"/>
            </VBox>
        </Tab>

    </TabPane>

    <!-- BOUTON VALIDER UE -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Valider / Echouer UE" onAction="#validerUE"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 16;"/>
        <Button text="Fermer" onAction="#fermer"
                style="-fx-background-color: #757575; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 16;"/>
    </HBox>

</VBox>