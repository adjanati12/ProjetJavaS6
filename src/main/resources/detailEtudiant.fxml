<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.DetailEtudiantController"
            style="-fx-background-color: #F0F2F8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-padding: 14 24;
                     -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <Button text="← Retour" onAction="#fermer"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 12;
                           -fx-cursor: hand; -fx-border-color: #CBD5E1; -fx-border-radius: 6;
                           -fx-background-radius: 6; -fx-padding: 6 12;"/>
            <Label fx:id="labelNom"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1C2A4A; -fx-font-family: 'Georgia';"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Modifier" onAction="#ouvrirModification"
                    style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-size: 12;
                           -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 8 16; -fx-cursor: hand;"/>
            <Button text="Fermer" onAction="#fermer"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 12;
                           -fx-background-radius: 7; -fx-padding: 8 14; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 20 24;">

            <!-- CARTE IDENTITÉ -->
            <HBox style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                <HBox spacing="32" style="-fx-padding: 20 28;" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <VBox spacing="3">
                        <Label text="N° ÉTUDIANT" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                        <Label fx:id="labelNumero" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="MENTION" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                        <Label fx:id="labelMention" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="PARCOURS" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                        <Label fx:id="labelParcours" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="SEMESTRE" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                        <Label fx:id="labelSemestre" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                    </VBox>
                </HBox>
                <!-- Bloc ECTS -->
                <VBox spacing="6" alignment="CENTER"
                      style="-fx-background-color: #1C2A4A; -fx-padding: 20 28;
                             -fx-background-radius: 0 12 12 0; -fx-min-width: 200;">
                    <Label text="ECTS VALIDÉS" style="-fx-font-size: 9; -fx-text-fill: #7B9CC8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelEcts"
                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Georgia';"/>
                    <ProgressBar fx:id="progressDiplome" prefWidth="150" prefHeight="6"
                                 style="-fx-accent: #5DADE2;"/>
                    <Label fx:id="labelPourcentage" style="-fx-font-size: 11; -fx-text-fill: #7B9CC8;"/>
                </VBox>
            </HBox>

            <!-- Label ECTS semestre -->
            <Label fx:id="labelEctsSemestre" maxWidth="Infinity"
                   style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-size: 12;
                          -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8;"/>

            <!-- ONGLETS -->
            <TabPane VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-tab-min-width: 130;">
                <Tab text="UE en cours" closable="false">
                    <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 16;
                                              -fx-background-radius: 0 10 10 10; -fx-border-color: #E2E8F0;
                                              -fx-border-radius: 0 10 10 10;">
                        <ListView fx:id="listeUeEnCours" prefHeight="180"
                                  style="-fx-background-radius: 8; -fx-border-color: #F1F5F9;"/>
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="Valider / Échouer l'UE sélectionnée" onAction="#validerUE"
                                    style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-size: 12;
                                           -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 8 16; -fx-cursor: hand;"/>
                            <Button text="+ Inscrire à une UE" onAction="#ajouterInscription"
                                    style="-fx-background-color: #1C2A4A; -fx-text-fill: white; -fx-font-size: 12;
                                           -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 8 16; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </Tab>
                <Tab text="UE validées" closable="false">
                    <VBox style="-fx-background-color: white; -fx-padding: 16;
                                 -fx-background-radius: 0 10 10 10; -fx-border-color: #E2E8F0; -fx-border-radius: 0 10 10 10;">
                        <ListView fx:id="listeUeValidees" prefHeight="210"
                                  style="-fx-background-radius: 8; -fx-border-color: #F1F5F9;"/>
                    </VBox>
                </Tab>
                <Tab text="UE disponibles" closable="false">
                    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 16;
                                              -fx-background-radius: 0 10 10 10; -fx-border-color: #E2E8F0; -fx-border-radius: 0 10 10 10;">
                        <Label text="Prérequis validés — non encore suivies ce semestre"
                               style="-fx-text-fill: #94A3B8; -fx-font-size: 11;"/>
                        <ListView fx:id="listeUEDisponibles" prefHeight="190"
                                  style="-fx-background-radius: 8; -fx-border-color: #F1F5F9;"/>
                    </VBox>
                </Tab>
                <Tab text="Historique" closable="false">
                    <VBox style="-fx-background-color: white; -fx-padding: 16;
                                 -fx-background-radius: 0 10 10 10; -fx-border-color: #E2E8F0; -fx-border-radius: 0 10 10 10;">
                        <ListView fx:id="listeHistorique" prefHeight="210"
                                  style="-fx-background-radius: 8; -fx-border-color: #F1F5F9;"/>
                    </VBox>
                </Tab>
            </TabPane>

        </VBox>
    </center>

</BorderPane>