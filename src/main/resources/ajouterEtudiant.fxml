<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.AjouterEtudiantController"
      style="-fx-background-color: #F0F2F8;" prefWidth="440">

    <VBox style="-fx-background-color: #1C2A4A; -fx-padding: 22 28 18 28;" spacing="4">
        <Label text="Ajouter un étudiant"
               style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Georgia';"/>
        <Label text="Remplissez les champs obligatoires (*)"
               style="-fx-font-size: 11; -fx-text-fill: #7B9CC8;"/>
    </VBox>

    <VBox spacing="14" style="-fx-background-color: white; -fx-padding: 24 28;">
        <VBox spacing="5">
            <Label text="Numéro étudiant *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="champNumero" promptText="ex : 23011042"
                       style="-fx-font-size: 13; -fx-padding: 9 12; -fx-background-radius: 8;
                              -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: white;"/>
        </VBox>
        <HBox spacing="12">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Nom *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <TextField fx:id="champNom" promptText="ex : Dupont"
                           style="-fx-font-size: 13; -fx-padding: 9 12; -fx-background-radius: 8;
                                  -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: white;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Prénom *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <TextField fx:id="champPrenom" promptText="ex : Marie"
                           style="-fx-font-size: 13; -fx-padding: 9 12; -fx-background-radius: 8;
                                  -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: white;"/>
            </VBox>
        </HBox>
        <VBox spacing="5">
            <Label text="Mention" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <ComboBox fx:id="comboMention" promptText="Choisir une mention" maxWidth="Infinity"
                      style="-fx-font-size: 13; -fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Parcours" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <ComboBox fx:id="comboParcours" promptText="Choisir un parcours" maxWidth="Infinity"
                      style="-fx-font-size: 13; -fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;"/>
        </VBox>
        <Label fx:id="messageErreur" text=""
               style="-fx-text-fill: #DC2626; -fx-font-size: 12; -fx-background-color: #FEF2F2;
                      -fx-padding: 8 12; -fx-background-radius: 7;" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT"
          style="-fx-padding: 16 28; -fx-background-color: #F8FAFC;
                 -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
        <Button text="Annuler" onAction="#annuler"
                style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 13;
                       -fx-background-radius: 8; -fx-padding: 9 20; -fx-border-color: #CBD5E1;
                       -fx-border-radius: 8; -fx-cursor: hand;"/>
        <Button text="Ajouter l'étudiant" onAction="#ajouter"
                style="-fx-background-color: #1C6B43; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>