<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.AjouterEtudiantController"
      style="-fx-padding: 20; -fx-background-color: white;">
    <Label text="Ajouter un étudiant" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    <Separator/>
    <GridPane hgap="10" vgap="10">
        <Label text="Numéro :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="champNumero" promptText="ex: 12345" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Nom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="champNom" promptText="ex: Dupont" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Prénom :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="champPrenom" promptText="ex: Marie" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="messageErreur" style="-fx-text-fill: red;"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#annuler"/>
        <Button text="Ajouter" onAction="#ajouter" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
</VBox>
