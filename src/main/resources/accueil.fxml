<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.AccueilController"
      style="-fx-padding: 20;">

    <HBox style="-fx-padding: 0 0 5 0;">
        <Label text="Suivi des etudiants"
               style="-fx-font-size: 22; -fx-font-weight: bold;"/>
        <Label fx:id="labelSemestre"
               style="-fx-text-fill: #2196F3; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 6 0 0 20;"/>
    </HBox>

    <Label text="Double-cliquez sur un etudiant pour voir ses details"
           style="-fx-text-fill: gray; -fx-font-size: 11; -fx-padding: 0 0 10 0;"/>

    <ListView fx:id="listeEtudiants"
              VBox.vgrow="ALWAYS"
              style="-fx-font-size: 13;"/>

    <HBox spacing="12" style="-fx-padding: 15 0 0 0;">
        <Button text="Ajouter" onAction="#ouvrirFormulaireAjout"
                prefHeight="35" prefWidth="110"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        <Button text="Modifier" onAction="#ouvrirFormulaireModification"
                prefHeight="35" prefWidth="110"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        <Button text="Supprimer" onAction="#supprimerEtudiant"
                prefHeight="35" prefWidth="110"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        <Button text="Passer au semestre suivant" onAction="#passerSemestreSuivant"
                prefHeight="35" prefWidth="230"
                style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>
</VBox>
