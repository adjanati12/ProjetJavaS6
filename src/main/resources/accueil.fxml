<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.AccueilController"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Suivi des étudiants – Formation à la Carte"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
        <Label fx:id="labelSemestre"
               style="-fx-text-fill: #2196F3; -fx-font-weight: bold; -fx-font-size: 13;
                      -fx-background-color: #e3f2fd; -fx-padding: 4 10; -fx-background-radius: 10;"/>
    </HBox>

    <Separator style="-fx-padding: 8 0;"/>

    <!-- STATS -->
    <HBox spacing="15" style="-fx-padding: 10 0;">
        <Label fx:id="labelTotalEtudiants"
               style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-weight: bold;
                      -fx-padding: 6 14; -fx-background-radius: 8; -fx-font-size: 12;"/>
        <Label fx:id="labelStatMiage"
               style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;
                      -fx-padding: 6 14; -fx-background-radius: 8; -fx-font-size: 12;"/>
        <Label fx:id="labelStatIO"
               style="-fx-background-color: #0277bd; -fx-text-fill: white; -fx-font-weight: bold;
                      -fx-padding: 6 14; -fx-background-radius: 8; -fx-font-size: 12;"/>
        <Label fx:id="labelDiplomes"
               style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;
                      -fx-padding: 6 14; -fx-background-radius: 8; -fx-font-size: 12;"/>
    </HBox>

    <!-- FILTRES -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;
                 -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
        <Label text="🔍 Filtres :" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
        <ComboBox fx:id="filtresMention" promptText="Toutes les mentions"
                  prefWidth="180" style="-fx-font-size: 12;"/>
        <ComboBox fx:id="filtresParcours" promptText="Tous les parcours"
                  prefWidth="180" style="-fx-font-size: 12;"/>
        <TextField fx:id="champRecherche" promptText="Nom, prénom, n° étudiant..."
                   prefWidth="200" style="-fx-font-size: 12;"/>
        <Button text="Appliquer" onAction="#appliquerFiltres"
                style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 5; -fx-padding: 6 14;"/>
        <Button text="Réinitialiser" onAction="#reinitialiserFiltres"
                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 5; -fx-padding: 6 14;"/>
    </HBox>

    <!-- BARRE ACTIONS + COMPTEUR -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 0 5 0;">
        <Label fx:id="labelNbResultats"
               style="-fx-font-size: 12; -fx-text-fill: #555;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter un étudiant" onAction="#ouvrirFormulaireAjout"
                prefHeight="35"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>

    <!-- TABLEAU -->
    <TableView fx:id="tableEtudiants" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 8;">
        <columns>
            <TableColumn fx:id="colNumero" text="N° Étudiant" prefWidth="100"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="120"/>
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/>
            <TableColumn fx:id="colParcours" text="Parcours" prefWidth="100"/>
            <TableColumn fx:id="colEcts" text="ECTS validés" prefWidth="100"/>
            <TableColumn fx:id="colUeEnCours" text="UE en cours" prefWidth="90"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
        </columns>
    </TableView>

    <!-- BOUTONS BAS -->
    <HBox spacing="12" style="-fx-padding: 12 0 0 0;">
        <Button text="✏️ Modifier" onAction="#ouvrirFormulaireModification"
                prefHeight="35" prefWidth="120"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 5;"/>
        <Button text="🗑️ Supprimer" onAction="#supprimerEtudiant"
                prefHeight="35" prefWidth="120"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 5;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⏭️ Semestre suivant" onAction="#passerSemestreSuivant"
                prefHeight="35"
                style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>

</VBox>