<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.AccueilController"
            style="-fx-background-color: #F0F2F8;">

    <!-- SIDEBAR GAUCHE -->
    <left>
        <VBox style="-fx-background-color: #1C2A4A; -fx-min-width: 220; -fx-max-width: 220; -fx-padding: 0;"
              spacing="0">

            <VBox style="-fx-padding: 28 20 24 20; -fx-background-color: #14203A;" spacing="4">
                <Label text="UniSuivi"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Georgia';"/>
                <Label text="Formation à la Carte"
                       style="-fx-font-size: 11; -fx-text-fill: #7B9CC8;"/>
            </VBox>

            <VBox style="-fx-padding: 16 20; -fx-background-color: #243358;" spacing="3">
                <Label text="SEMESTRE EN COURS"
                       style="-fx-font-size: 9; -fx-text-fill: #7B9CC8; -fx-font-weight: bold;"/>
                <Label fx:id="labelSemestre"
                       style="-fx-font-size: 13; -fx-text-fill: #5DADE2; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="2" style="-fx-padding: 16 12;">
                <Label text="NAVIGATION"
                       style="-fx-font-size: 9; -fx-text-fill: #4A6491; -fx-font-weight: bold; -fx-padding: 0 8 8 8;"/>
                <Button text="  Étudiants" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: #2C3E6B; -fx-text-fill: white; -fx-font-size: 13;
                               -fx-background-radius: 6; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="  Saisie des résultats" maxWidth="Infinity" alignment="CENTER_LEFT"
                        onAction="#ouvrirSaisieResultats"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0BAD8; -fx-font-size: 13;
                               -fx-background-radius: 6; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="  UE et Formations" maxWidth="Infinity" alignment="CENTER_LEFT"
                        onAction="#ouvrirUEFormations"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0BAD8; -fx-font-size: 13;
                               -fx-background-radius: 6; -fx-padding: 10 12; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 16 12 24 12;" spacing="8">
                <Separator style="-fx-background-color: #2C3E6B;"/>
                <Button text="→ Semestre suivant" maxWidth="Infinity"
                        onAction="#passerSemestreSuivant"
                        style="-fx-background-color: #7B3FA0; -fx-text-fill: white; -fx-font-size: 12;
                               -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 9 0; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="0">

            <!-- TOPBAR -->
            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-color: white; -fx-padding: 14 24;
                         -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
                <Label text="Gestion des étudiants"
                       style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Ajouter un étudiant" onAction="#ouvrirFormulaireAjout"
                        style="-fx-background-color: #1C6B43; -fx-text-fill: white; -fx-font-size: 13;
                               -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 18; -fx-cursor: hand;"/>
            </HBox>

            <!-- STATS CARDS -->
            <HBox spacing="16" style="-fx-padding: 20 24 12 24;">
                <VBox style="-fx-background-color: white; -fx-padding: 16 20; -fx-background-radius: 10;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-min-width: 140;" spacing="4">
                    <Label text="TOTAL ÉTUDIANTS" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelTotalEtudiants" text="—"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-padding: 16 20; -fx-background-radius: 10;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-min-width: 140;" spacing="4">
                    <Label text="PARCOURS MIAGE" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelStatMiage" text="—"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-padding: 16 20; -fx-background-radius: 10;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-min-width: 140;" spacing="4">
                    <Label text="PARCOURS IO" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelStatIO" text="—"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0891B2;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-padding: 16 20; -fx-background-radius: 10;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-min-width: 140;" spacing="4">
                    <Label text="DIPLÔMÉS" style="-fx-font-size: 9; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                    <Label fx:id="labelDiplomes" text="—"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                </VBox>
            </HBox>

            <!-- FILTRES -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 24 14 24;">
                <ComboBox fx:id="filtresMention" promptText="Toutes les mentions" prefWidth="200"
                          style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1;
                                 -fx-border-radius: 7; -fx-background-color: white;"/>
                <ComboBox fx:id="filtresParcours" promptText="Tous les parcours" prefWidth="200"
                          style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1;
                                 -fx-border-radius: 7; -fx-background-color: white;"/>
                <TextField fx:id="champRecherche" promptText="Rechercher un étudiant..." prefWidth="240"
                           style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1;
                                  -fx-border-radius: 7; -fx-background-color: white; -fx-padding: 7 12;"/>
                <Button text="Filtrer" onAction="#appliquerFiltres"
                        style="-fx-background-color: #1C2A4A; -fx-text-fill: white; -fx-font-size: 12;
                               -fx-background-radius: 7; -fx-padding: 8 16; -fx-cursor: hand;"/>
                <Button text="Réinitialiser" onAction="#reinitialiserFiltres"
                        style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 12;
                               -fx-background-radius: 7; -fx-padding: 8 12; -fx-border-color: #CBD5E1;
                               -fx-border-radius: 7; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelNbResultats" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
            </HBox>

            <!-- TABLEAU -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 24 0 24;">
                <TableView fx:id="tableEtudiants" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-background-radius: 10;
                                  -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colNumero" text="N° Étudiant" prefWidth="110"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="130"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="130"/>
                        <TableColumn fx:id="colParcours" text="Parcours" prefWidth="100"/>
                        <TableColumn fx:id="colEcts" text="ECTS validés" prefWidth="110"/>
                        <TableColumn fx:id="colUeEnCours" text="UE en cours" prefWidth="100"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- BARRE BAS -->
            <HBox spacing="10" style="-fx-padding: 14 24;">
                <Button text="Modifier la sélection" onAction="#ouvrirFormulaireModification"
                        style="-fx-background-color: white; -fx-text-fill: #2563EB; -fx-font-size: 12;
                               -fx-background-radius: 7; -fx-padding: 8 16; -fx-border-color: #BFDBFE;
                               -fx-border-radius: 7; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Supprimer" onAction="#supprimerEtudiant"
                        style="-fx-background-color: white; -fx-text-fill: #DC2626; -fx-font-size: 12;
                               -fx-background-radius: 7; -fx-padding: 8 16; -fx-border-color: #FECACA;
                               -fx-border-radius: 7; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>