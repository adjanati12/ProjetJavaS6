<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.UEFormationsController"
            style="-fx-background-color: #F0F2F8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-padding: 14 24;
                     -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="2">
                <Label text="UE et Formations"
                       style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1C2A4A;"/>
                <Label text="Lecture seule — la structure se modifie hors application"
                       style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="comboMention" prefWidth="200" promptText="Toutes les mentions"
                      style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1; -fx-border-radius: 7;"/>
            <ComboBox fx:id="comboParcours" prefWidth="200" promptText="Tous les parcours"
                      style="-fx-font-size: 12; -fx-background-radius: 7; -fx-border-color: #CBD5E1; -fx-border-radius: 7;"/>
            <Button text="Fermer" onAction="#fermer"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 12;
                           -fx-background-radius: 7; -fx-padding: 8 14; -fx-border-color: #E2E8F0;
                           -fx-border-radius: 7; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20 24;">
            <TableView fx:id="tableUE" VBox.vgrow="ALWAYS" editable="false"
                       style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                <columns>
                    <TableColumn fx:id="colCode" text="Code" prefWidth="100"/>
                    <TableColumn fx:id="colNom" text="Nom de l'UE" prefWidth="250"/>
                    <TableColumn fx:id="colEcts" text="ECTS" prefWidth="80"/>
                    <TableColumn fx:id="colPrerequis" text="Prérequis" prefWidth="220"/>
                    <TableColumn fx:id="colObligatoire" text="Obligatoire" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>