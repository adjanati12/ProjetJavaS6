<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.InscriptionController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Choisir une UE :" />
    <ComboBox fx:id="comboUE" maxWidth="Infinity" />

    <Label fx:id="messageErreur" style="-fx-text-fill: red;" text="" />

    <HBox spacing="10">
        <Button text="Inscrire" onAction="#inscrire" />
        <Button text="Annuler" onAction="#annuler" />
    </HBox>
</VBox>